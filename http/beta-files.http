### 16. Скачиваем напрямую из Supabase
GET {{downloadUrl}}

> {%
    client.test("Signed URL работает без JWT", function() {
        client.assert(response.status === 200);
    });
%}

### 17. Проверка приватности через публичный маршрут Supabase
GET https://cukokjzhsriszjofnagj.supabase.co/storage/v1/object/public/birchat-beta-files/companies/b1ff2b22-0c17-4023-9e0a-db00c5ba0e5c/2026-11-09/27962db5-b6a0-4cd4-a7f0-1f4fbfb1c26e.txt

> {%
    client.test("Приватный bucket не отдаёт публичный файл", function() {
        client.assert(
            response.status >= 400 && response.status < 500,
            "Ожидали отказ 4xx, получили " + response.status
        );
    });
%}
