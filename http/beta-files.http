### 9. ADMIN получает Signed URL
GET {{baseUrl}}/api/companies/{{companyId}}/files/{{fileId}}/download-url?expiresInSeconds=300
Authorization: Bearer {{accessToken}}

> {%
    client.test("ADMIN может скачать файл", function() {
        client.assert(response.status === 200);
        client.assert(!!response.body.downloadUrl);
    });
%}

### 10. Посторонний не видит файлы компании
GET {{baseUrl}}/api/companies/{{companyId}}/files
Authorization: Bearer {{accessToken}}

> {%
    client.test("Список чужих файлов запрещён", function() {
