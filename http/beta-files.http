
### 1. Загрузка файла в Beta Storage
POST {{baseUrl}}/api/companies/{{companyId}}/files/upload
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=BirChatBoundary

--BirChatBoundary
Content-Disposition: form-data; name="file"; filename="test-upload.txt"
Content-Type: text/plain

< ./fixtures/test-upload.txt
--BirChatBoundary--

> {%
    client.test("Файл загружен: 201", function() {
        client.assert(response.status === 201);
        client.assert(!!response.body.id);
    });

    if (response.status === 201 && response.body.id) {
        client.global.set("fileId", response.body.id);
        client.global.set("rawFileUrl", response.body.fileUrl);
    }
%}

### 2. Получить список файлов компании
GET {{baseUrl}}/api/companies/{{companyId}}/files?limit=10
Authorization: Bearer {{accessToken}}

> {%
    client.test("Список файлов: 200", function() {
        client.assert(response.status === 200);
        client.assert(Array.isArray(response.body));
    });
%}

### 3. Получить конкретный файл
GET {{baseUrl}}/api/companies/{{companyId}}/files/{{fileId}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("Информация о файле: 200", function() {
        client.assert(response.status === 200);
        client.assert(response.body.id === client.global.get("fileId"));
    });
%}

### 4. Получить временную ссылку
GET {{baseUrl}}/api/companies/{{companyId}}/files/{{fileId}}/download-url?expiresInSeconds=300
Authorization: Bearer {{accessToken}}

> {%
    client.test("Signed URL получен: 200", function() {
        client.assert(response.status === 200);
        client.assert(!!response.body.downloadUrl);
    });

    if (response.status === 200 && response.body.downloadUrl) {
        client.global.set("downloadUrl", response.body.downloadUrl);
    }
%}

### 5. Прямая ссылка без авторизации
GET {{rawFileUrl}}

> {%
    client.test("Приватный файл не доступен напрямую", function() {
        client.assert(
            response.status < 200 || response.status >= 300,
            "Файл не должен быть публично доступен"
        );
    });
%}

### 6. Signed URL без JWT
GET {{downloadUrl}}

> {%
    client.test("Signed URL разрешает скачивание", function() {
        client.assert(
            response.status === 200,
            "Ожидали 200, получили " + response.status
        );
    });
%}

### Посторонний пользователь не может получить signed URL
GET {{baseUrl}}/api/companies/{{companyId}}/files/{{fileId}}/download-url?expiresInSeconds=300
Authorization: Bearer {{accessToken}}

> {%
    client.test("Чужой файл недоступен", function() {
        client.assert(response.status === 403);
        client.assert(response.body.code === "NOT_A_MEMBER");
    });
%}


