### 13. Посторонний не может загрузить файл
POST {{baseUrl}}/api/companies/{{companyId}}/files/upload
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=BirChatBoundary

--BirChatBoundary
Content-Disposition: form-data; name="file"; filename="test-upload.txt"
Content-Type: text/plain

< ./fixtures/test-upload.txt
--BirChatBoundary--

> {%
    client.test("Загрузка посторонним запрещена", function() {
        client.assert(response.status === 403);
        client.assert(response.body.code === "NOT_A_MEMBER");
    });
%}

### 14. Приватный файл без авторизации Supabase
GET {{rawFileUrl}}

> {%
    client.test("Прямой доступ к приватному файлу запрещён", function() {
        client.assert(
            response.status >= 400 && response.status < 500,
            "Ожидали отказ 4xx, получили " + response.status
        );
    });
%}

