# Copy values to the beta service Environment in Render (or your beta host).
# This file is only a template. Never commit real credentials.
SPRING_PROFILES_ACTIVE=beta
BETA_DATASOURCE_URL=jdbc:postgresql://YOUR_BETA_NEON_DIRECT_HOST/birchat_beta?sslmode=require&currentSchema=birchat
BETA_DATASOURCE_USERNAME=YOUR_BETA_DB_USER
BETA_DATASOURCE_PASSWORD=REPLACE_ME
BETA_AUTH_SMS_OTP_SECRET=GENERATE_A_NEW_BETA_SECRET
# Optional: dedicated non-personal demo phone. Keep the real code private.
BETA_AUTH_SMS_DEMO_PHONE=
BETA_AUTH_SMS_DEMO_CODE=
# Safe beta default; will become telegram when Gateway integration is ready.
BETA_SMS_PROVIDER=disabled
BETA_AI_PROVIDER=mock
# Configure separate beta storage, do not point beta to production bucket.
BETA_SUPABASE_URL=
BETA_SUPABASE_SERVICE_KEY=
BETA_SUPABASE_BUCKET=birchat-beta-files
# Optional for later (do not activate yet):
# BETA_AI_PROVIDER=glm
# BETA_AI_GLM_API_KEY=REPLACE_ME

# Independent random 32-byte key, Base64 encoded; never commit value.
BETA_JWT_SECRET_BASE64=
